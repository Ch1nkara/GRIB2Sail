FROM rust:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    ca-certificates \
    git \
    libegl1-mesa-dev \
    libfontconfig1-dev \
    libfreetype6-dev \
    libgl1-mesa-dev \
    libwayland-dev \
    libx11-dev \
    libx11-xcb-dev \
    libxcb-render0-dev \
    libxcb-shape0-dev \
    libxcursor-dev \
    libxkbcommon-x11-dev \
    libxkbcommon-dev \
    libxrandr-dev \
    libxi-dev \
    xinput \
  && rustup component add rustfmt clippy \
  && rm -rf /var/lib/apt/lists/*

RUN useradd -ms /bin/bash vscode
USER vscode
WORKDIR /workspaces/Grib2Sail
CMD ["sleep", "infinity"]
