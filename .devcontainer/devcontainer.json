{
  "name": "grib2sail",
  "build": {
    "dockerfile": "Containerfile",
    "context": ".."
  },
  "overrideCommand": false,
  "shutdownAction": "none",
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,
  "runArgs": ["--env-file", "${localWorkspaceFolder}/.env"],
  "workspaceFolder": "/workspaces/Grib2Sail",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/Grib2Sail,type=bind,consistency=cached",
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer"]
    }
  }
}
